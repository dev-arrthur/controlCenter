# MongoDB Atlas (obrigatório)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=controlcenter_portal

# Recomendado em produção. Use uma chave aleatória com pelo menos 32 bytes.
# Se ausente, o backend consegue derivar uma chave estável do MONGODB_URI,
# mas um JWT_SECRET dedicado mantém a separação de segredos e é a configuração preferida.
JWT_SECRET=troque-por-uma-chave-segura-com-no-minimo-32-bytes

# Sessões
SESSION_COOKIE=cc_client_session
ADMIN_SESSION_COOKIE=cc_admin_session
SESSION_HOURS=8

# Anexos privados (Vercel Blob)
# Crie um Blob Store com acesso PRIVATE e conecte-o ao projeto.
# A Vercel adiciona BLOB_READ_WRITE_TOKEN automaticamente quando o store é conectado.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
