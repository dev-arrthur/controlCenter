{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/portal.js": { "maxDuration": 15 },
    "api/gateway.js": { "maxDuration": 15 },
    "api/admin-enterprise.js": { "maxDuration": 15 },
    "api/attachment.js": { "maxDuration": 30 },
    "api/socket.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/portal", "destination": "/api/gateway" },
    { "source": "/cliente", "destination": "/workspace/client/loginClient.html" },
    { "source": "/portal", "destination": "/workspace/client/loginClient.html" }
  ],
  "headers": [
    {
      "source": "/workspace/client/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/workspace/admin/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
